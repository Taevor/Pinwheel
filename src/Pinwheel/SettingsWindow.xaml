<Window x:Class="Pinwheel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinwheel 设置"
        Width="1040" Height="870"
        MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="{StaticResource FluentWindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 Header（清晰锐利、无离屏渲染滤镜） -->
        <Grid Grid.Row="0" Margin="4,0,4,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="{StaticResource FluentCardBorder}"
                        BorderThickness="1" Margin="0,0,12,0" SnapsToDevicePixels="True">
                    <Image Source="assets/Pinwheel-32.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pinwheel 设置" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" />
                    <TextBlock Text="管理触发方式、全局指令，以及每个软件自己的专属轮盘快捷动作。"
                               FontSize="12" Foreground="{StaticResource FluentTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 主选项卡（UWP 自适应导航风格，间距宽裕，随窗口宽度自适应拉伸） -->
        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged"
                    Background="Transparent" BorderThickness="0">

            <!-- 1. 通用设置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12 8 C 9.79 8 8 9.79 8 12 C 8 14.21 9.79 16 12 16 C 14.21 16 16 14.21 16 12 C 16 9.79 14.21 8 12 8 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.72 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.04 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="通用设置" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- 去除 DropShadowEffect，确保卡片内所有文字享受原生硬件 ClearType 极清渲染 -->
                <Border Background="{StaticResource FluentCardBackground}" CornerRadius="8"
                        BorderBrush="{StaticResource FluentCardBorder}" BorderThickness="1"
                        Padding="28" Margin="0,12,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="340" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" MinWidth="340" />
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：触发与手势 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="触发与手势" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" Margin="0,0,0,16" />

                                <TextBlock Text="触发方式" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="TriggerModeBox" Height="32" Margin="0,0,0,18" SelectionChanged="General_Changed" />

                                <TextBlock Text="长按时间（毫秒）" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="HoldBox" Height="32" Margin="0,0,0,18" IsEditable="True" SelectionChanged="General_Changed" />

                                <TextBlock Text="移动判定（像素）" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="MoveBox" Height="32" Margin="0,0,0,18" IsEditable="True" SelectionChanged="General_Changed" />
                            </StackPanel>

                            <!-- 右栏：外观与系统 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="外观与系统行为" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" Margin="0,0,0,16" />

                                <TextBlock Text="轮盘直径（像素）" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="SizeBox" Height="32" Margin="0,0,0,18" SelectionChanged="General_Changed" />

                                <TextBlock Text="主题风格" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" Margin="0,0,0,6" />
                                <ComboBox x:Name="ThemeBox" Height="32" Margin="0,0,0,18" SelectionChanged="General_Changed" />

                                <StackPanel Margin="0,4,0,18">
                                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,0,0,12"
                                              Checked="General_Changed" Unchecked="General_Changed" />
                                    <CheckBox x:Name="ErrorBalloonCheck" Content="指令失败时在右下角弹出提示提醒" Margin="0,0,0,0"
                                              Checked="General_Changed" Unchecked="General_Changed" />
                                </StackPanel>

                                <Button Click="SaveGeneral_Click" Style="{StaticResource FluentAccentButton}" Height="36" MinWidth="136" HorizontalAlignment="Left" Padding="18,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 9 16.2 L 4.8 12 L 3.4 13.4 L 9 19 L 21 7 L 19.6 5.6 L 9 16.2 Z"
                                              Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="保存设置" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <WrapPanel Margin="0,20,0,0">
                                    <Button Click="ExportConfig_Click" Height="32" MinWidth="116" Padding="14,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 5 20 L 19 20 L 19 18 L 5 18 L 5 20 Z M 12 3 L 6 9 L 7.4 10.4 L 11 6.8 L 11 16 L 13 16 L 13 6.8 L 16.6 10.4 L 18 9 L 12 3 Z"
                                                  Fill="{StaticResource FluentTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="导出配置…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ImportConfig_Click" Height="32" MinWidth="116" Padding="14,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 19 9 L 13 9 L 13 3 L 11 3 L 11 9 L 5 9 L 12 16 L 19 9 Z M 5 18 L 5 20 L 19 20 L 19 18 L 5 18 Z"
                                                  Fill="{StaticResource FluentTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="导入配置…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RestoreBackup_Click" Height="32" MinWidth="116" Padding="14,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 13 3 C 8.03 3 4 7.03 4 12 L 1 12 L 4.89 15.89 L 8.78 12 L 6 12 C 6 8.13 9.13 5 13 5 C 16.87 5 20 8.13 20 12 C 20 15.87 16.87 19 13 19 C 11.07 19 9.32 18.21 8.06 16.94 L 6.64 18.36 C 8.27 19.99 10.51 21 13 21 C 17.97 21 22 16.97 22 12 C 22 7.03 17.97 3 13 3 Z M 12 8 L 12 13 L 16.2 15.5 L 17 14.2 L 13.5 12.2 L 13.5 8 L 12 8 Z"
                                                  Fill="{StaticResource FluentTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="恢复备份…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="导入会覆盖当前全部设置，恢复备份可找回历史快照。" Foreground="{StaticResource FluentTextTertiary}" FontSize="12" Margin="2,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- 2. 软件设置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="软件设置" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource FluentCardBackground}" CornerRadius="8"
                        BorderBrush="{StaticResource FluentCardBorder}" BorderThickness="1"
                        Padding="20" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：软件列表与添加 -->
                        <DockPanel Grid.Column="0">
                            <!-- 底部：添加新软件与删除 -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="RunningAppsBox" Grid.Column="0" Height="32" IsEditable="True">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Click="RefreshApps_Click" Width="44" Height="32" Margin="6,0,0,0" ToolTip="刷新运行中软件">
                                        <Path Data="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 L 17.65 14 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 L 17.65 6.35 Z"
                                              Fill="{StaticResource FluentTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                    <Button Grid.Column="2" Click="AddApp_Click" Width="60" Height="32" Margin="6,0,0,0" Style="{StaticResource FluentAccentButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 Z"
                                                  Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="添加" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button Click="DeleteApp_Click" Style="{StaticResource FluentDangerButton}" Height="32" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                              Fill="{StaticResource FluentDanger}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="删除当前软件" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 顶部搜索框 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox x:Name="SceneSearchBox" Height="32" TextChanged="SceneSearchBox_TextChanged"
                                         ToolTip="输入关键字筛选软件列表" Padding="28,5,8,5" />
                                <Path Data="M 9.5 3 C 5.91 3 3 5.91 3 9.5 C 3 13.09 5.91 16 9.5 16 C 11.01 16 12.39 15.48 13.5 14.62 L 17.56 18.68 L 18.68 17.56 L 14.62 13.5 C 15.48 12.39 16 11.01 16 9.5 C 16 5.91 13.09 3 9.5 3 Z M 9.5 4.5 C 12.26 4.5 14.5 6.74 14.5 9.5 C 14.5 12.26 12.26 14.5 9.5 14.5 C 6.74 14.5 4.5 12.26 4.5 9.5 C 4.5 6.74 6.74 4.5 9.5 4.5 Z"
                                      Fill="{StaticResource FluentTextTertiary}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="9,0,0,0"
                                      IsHitTestVisible="False" />
                                <TextBlock x:Name="SceneSearchHint" Text="搜索软件…" Foreground="{StaticResource FluentTextTertiary}"
                                           Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" />
                            </Grid>

                            <!-- 软件列表 -->
                            <ListBox x:Name="SceneList" SelectionChanged="SceneList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <!-- Fluent 图标基底容器 -->
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#F2F4F7"
                                                    BorderBrush="#E5E8EC" BorderThickness="1" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Emoji}" FontSize="14"
                                                               FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource FluentTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="174" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 分割线 -->
                        <Border Grid.Column="1" Width="1" Background="{StaticResource FluentCardBorder}" HorizontalAlignment="Center" />

                        <!-- 右侧：软件指令与轮盘布局 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 工具栏 -->
                            <StackPanel Grid.Row="0" Margin="2,0,0,12">
                                <WrapPanel x:Name="AppControlsRow" Margin="0,0,0,10">
                                    <CheckBox x:Name="AppEnabledCheck" Content="启用此软件（按触发键响应）"
                                              Visibility="Collapsed" Margin="0,0,20,0"
                                              Checked="AppEnabledCheck_Changed" Unchecked="AppEnabledCheck_Changed" />
                                    <CheckBox x:Name="AppFullscreenCheck" Content="全屏时不响应"
                                              Visibility="Collapsed"
                                              Checked="AppFullscreenCheck_Changed" Unchecked="AppFullscreenCheck_Changed" />
                                    <TextBlock Text="触发方式" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" Margin="0,0,8,0" FontSize="13" />
                                    <ComboBox x:Name="AppTriggerModeBox" Width="120" Height="30"
                                              SelectionChanged="AppTriggerModeBox_Changed" />
                                </WrapPanel>
                                <WrapPanel x:Name="LayoutRow" Margin="0,0,0,4">
                                    <TextBlock Text="轮盘布局" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" Margin="0,0,10,0" FontSize="13" />
                                    <ComboBox x:Name="SlotLayoutBox" Width="110" Height="30"
                                              SelectionChanged="SlotLayoutBox_SelectionChanged" />
                                    <TextBlock Text="一圈：内圈 8 格　两圈：内圈 8 + 外圈 16"
                                               Foreground="{StaticResource FluentTextTertiary}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 全局网格展示 -->
                            <ScrollViewer x:Name="GlobalScroll" Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          Visibility="Collapsed">
                                <WrapPanel x:Name="GlobalSlotPanel" Background="Transparent"
                                           MouseLeftButtonDown="GlobalSlotPanel_MouseLeftButtonDown" />
                            </ScrollViewer>

                            <!-- 分软件轮盘展示 -->
                            <ScrollViewer x:Name="AppScroll" Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="AppSlotPanel" Width="540" Height="390" Background="Transparent"
                                        MouseLeftButtonDown="AppSlotPanel_MouseLeftButtonDown"
                                        MouseMove="AppSlotPanel_MouseMove"
                                        MouseLeftButtonUp="AppSlotPanel_MouseLeftButtonUp" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 3. 指令包（软件分类横幅高大醒目，列表无列宽限制自适应拉伸，名称下方无冗余简介，选中在底部显示详情，支持多选） -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12 2 L 3 7 L 3 17 L 12 22 L 21 17 L 21 7 Z M 12 4.2 L 18.2 7.7 L 12 11.2 L 5.8 7.7 Z M 5 9.5 L 11 13 L 11 19.8 L 5 16.3 Z M 13 19.8 L 13 13 L 19 9.5 L 19 16.3 Z"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="指令包" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource FluentCardBackground}" CornerRadius="8"
                        BorderBrush="{StaticResource FluentCardBorder}" BorderThickness="1"
                        Padding="18" Margin="0,12,0,0">
                    <DockPanel SizeChanged="PackageArea_SizeChanged">
                        <!-- 底部说明栏：统一在最下面呈现详细简介与批量信息 -->
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FluentCardBackgroundSecondary}"
                                BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 L 11 17 L 11 11 L 13 11 L 13 17 Z M 13 9 L 11 9 L 11 7 L 13 7 L 13 9 Z"
                                          Fill="{StaticResource FluentAccent}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="PackageDetailTitle" Text="指令包说明" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PackageDetailSoftware" Foreground="{StaticResource FluentAccent}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" />
                                </StackPanel>
                                <TextBlock x:Name="PackageDescText" Grid.Row="1" Foreground="{StaticResource FluentTextSecondary}" TextWrapping="Wrap"
                                           FontSize="12.5" LineHeight="19" Text="在上方列表中点击或按住 Ctrl/Shift 多选指令包，可在此处查看详细功能说明；安装和卸载均已支持多选。" />
                            </Grid>
                        </Border>

                        <!-- 顶部工具栏（支持多选安装、批量卸载与清晰双行指引） -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="InstallPackage_Click" Style="{StaticResource FluentAccentButton}" Height="34" MinWidth="130" Padding="16,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 19 9 L 13 9 L 13 3 L 11 3 L 11 9 L 5 9 L 12 16 L 19 9 Z M 5 18 L 5 20 L 19 20 L 19 18 L 5 18 Z"
                                          Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="安装指令包…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="UninstallPackage_Click" Style="{StaticResource FluentDangerButton}" Height="34" MinWidth="100" Padding="14,6" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                          Fill="{StaticResource FluentDanger}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="卸载选中" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Path Data="M 19 9 L 13 9 L 13 3 L 11 3 L 11 9 L 5 9 L 12 16 L 19 9 Z M 5 18 L 5 20 L 19 20 L 19 18 L 5 18 Z"
                                          Fill="{StaticResource FluentAccent}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="可将 .zip 指令包直接拖拽至下方列表区域快速安装"
                                               Foreground="{StaticResource FluentTextPrimary}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 L 11 17 L 11 11 L 13 11 L 13 17 Z M 13 9 L 11 9 L 11 7 L 13 7 L 13 9 Z"
