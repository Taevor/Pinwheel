                                        </StackPanel>
                                        <TextBlock Text="内环 8 格专为高频盲操设计，外环 16 格分设当前软件专属动作与全局常用动作。等宽平行间隙算法，现代规整。"
                                                   Foreground="{StaticResource FluentTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2 -->
                                <Border Background="{StaticResource FluentCardBackgroundSecondary}" CornerRadius="8"
                                        BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1"
                                        Padding="16" Margin="8,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="原生硬件高刷极速渲染" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource FluentTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="全新高性能直出架构，0 截屏、0 软件模糊，视觉树持久化复用，144Hz 显示器刷新率逐帧垂直同步响应，零卡顿瞬间唤出。"
                                                   Foreground="{StaticResource FluentTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 3 -->
                                <Border Background="{StaticResource FluentCardBackgroundSecondary}" CornerRadius="8"
                                        BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1"
                                        Padding="16" Margin="0,8,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🔀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="多场景智能感知与分软件动作" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource FluentTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="自动精准识别前台活跃进程（Office、Adobe、专业绘图等），轮盘动作随场景实时流转，不在设定软件时优雅回退全局。"
                                                   Foreground="{StaticResource FluentTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 4 -->
                                <Border Background="{StaticResource FluentCardBackgroundSecondary}" CornerRadius="8"
                                        BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1"
                                        Padding="16" Margin="8,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🧩" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="强大指令生态与划词翻译" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource FluentTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="支持程序、网页、文件夹、快捷键、文本、脚本及组合动作；支持 .zip 指令包一键拖拽安装；内置独立单例 AI 划词翻译引擎。"
                                                   Foreground="{StaticResource FluentTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 版权与开源许可证信息 -->
                            <Border Background="{StaticResource FluentCardBackgroundSecondary}" CornerRadius="8"
                                    BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="开源许可与声明" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource FluentTextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="本项目遵循 MIT License 协议完全开源。基于微软原生 C# / .NET 8 WPF 纯净架构独立研发，零专有第三方依赖，支持自由使用、修改与分发。"
                                                   Foreground="{StaticResource FluentTextTertiary}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Copyright © 2026 Pinwheel Contributors"
                                               Foreground="{StaticResource FluentTextTertiary}" FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 底部浮层卡片：编辑格子（同样去除 DropShadowEffect） -->
        <Border x:Name="EditorPanel" Grid.Row="2" Background="{StaticResource FluentCardBackground}" CornerRadius="8"
                BorderBrush="{StaticResource FluentCardBorder}" BorderThickness="1" Margin="0,18,0,0" Padding="20,16"
                Visibility="Collapsed">
            <StackPanel>
                <!-- 顶部栏：标题、关闭按钮、从指令包选择 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="编辑格子" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource FluentTextPrimary}" FontSize="14" />
                        <Button Content="✕" Width="26" Height="26" Margin="10,0,0,0" Padding="0"
                                Click="CloseEditor_Click" ToolTip="收起编辑栏" Style="{StaticResource FluentSubtleButton}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="从指令包选择" VerticalAlignment="Center"
                               Foreground="{StaticResource FluentTextPrimary}" Margin="24,0,8,0" FontSize="13" />
                    <ComboBox x:Name="PackageBox" Grid.Column="2" Height="30"
                              SelectionChanged="PackageBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="#F2F4F7" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="13"
                                                   FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="3" Click="RefreshPackages_Click" Height="30" MinWidth="68" Padding="12,4" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 L 17.65 14 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 L 17.65 6.35 Z"
                                  Fill="{StaticResource FluentTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Click="ExportPackage_Click" Height="30" MinWidth="106" Padding="12,4" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12 3 L 6 9 L 7.4 10.4 L 11 6.8 L 11 16 L 13 16 L 13 6.8 L 16.6 10.4 L 18 9 L 12 3 Z M 5 20 L 19 20 L 19 18 L 5 18 L 5 20 Z"
                                  Fill="{StaticResource FluentTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="导出指令包" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 参数编辑行（弹性自适应宽度） -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="名字" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                        <TextBox x:Name="NameBox" Width="130" Height="30" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="图标（Emoji）" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                        <TextBox x:Name="IconBox" Width="100" Height="30" Margin="0,4,0,0"
                                 FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol, sans-serif" FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="指令类型" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                        <ComboBox x:Name="TypeBox" Width="132" Height="30" Margin="0,4,0,0" SelectionChanged="TypeBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="TargetField" Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="目标" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetBox" Height="30" Grid.Column="0" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" Height="30" Margin="6,0,0,0"
                                    Visibility="Collapsed" Style="{StaticResource FluentAccentButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Path Data="M 10 4 L 4 4 C 2.9 4 2.01 4.9 2.01 6 L 2 18 C 2 19.1 2.9 20 4 20 L 20 20 C 21.1 20 22 19.1 22 18 L 22 8 C 22 6.9 21.1 6 20 6 L 12 6 L 10 4 Z"
                                          Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Click="TestAction_Click" Height="36" MinWidth="84" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 8 5 L 8 19 L 19 12 Z"
                                      Fill="{StaticResource FluentTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="测试" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="SaveSlot_Click" Style="{StaticResource FluentAccentButton}" Height="36" MinWidth="116" Padding="16,6" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 9 16.2 L 4.8 12 L 3.4 13.4 L 9 19 L 21 7 L 19.6 5.6 L 9 16.2 Z"
                                      Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="应用此格子" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 组合指令编辑区 -->
                <StackPanel x:Name="CompositePanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="步骤列表（按顺序执行）" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                    <ListBox x:Name="StepList" Height="92" Margin="0,6,0,8" SelectionChanged="StepList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="#F2F4F7" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="12"
                                                   FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Target}" Margin="12,0,0,0" Foreground="{StaticResource FluentTextTertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Click="AddStep_Click" Height="30" MinWidth="90" Padding="12,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 Z"
                                      Fill="{StaticResource FluentTextPrimary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="添加步骤" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="DeleteStep_Click" Style="{StaticResource FluentDangerButton}" Height="30" MinWidth="64" Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                      Fill="{StaticResource FluentDanger}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="删除" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="MoveStepUp_Click" Height="30" MinWidth="68" Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 7.41 15.41 L 12 10.83 L 16.59 15.41 L 18 14 L 12 8 L 6 14 Z"
                                      Fill="{StaticResource FluentTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="上移" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="MoveStepDown_Click" Height="30" MinWidth="68" Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 7.41 8.59 L 12 13.17 L 16.59 8.59 L 18 10 L 12 16 L 6 10 Z"
                                      Fill="{StaticResource FluentTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="下移" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="步骤间延时(ms)" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" Margin="14,0,8,0" />
                        <TextBox x:Name="DelayBox" Width="72" Height="30" />
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource FluentCardBorderSubtle}" BorderThickness="1" CornerRadius="6"
                            Background="{StaticResource FluentCardBackgroundSecondary}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名字" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                            <TextBox x:Name="StepNameBox" Grid.Column="1" Height="28" Margin="6,0,12,0" />
                            <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                            <ComboBox x:Name="StepTypeBox" Grid.Column="3" Height="28" Margin="6,0,12,0" />
                            <TextBlock Grid.Column="4" Text="图标" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                            <TextBox x:Name="StepIconBox" Grid.Column="5" Height="28" Margin="6,0,12,0"
                                     FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol" />
                            <TextBlock Grid.Column="6" Text="目标" VerticalAlignment="Center" Foreground="{StaticResource FluentTextPrimary}" FontSize="12" />
                            <TextBox x:Name="StepTargetBox" Grid.Column="7" Height="28" Margin="6,0,12,0" />
                            <Button Grid.Column="8" Click="SaveStep_Click" Style="{StaticResource FluentAccentButton}" Height="28">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Path Data="M 9 16.2 L 4.8 12 L 3.4 13.4 L 9 19 L 21 7 L 19.6 5.6 L 9 16.2 Z"
                                          Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="保存步骤" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="HintText" Foreground="{StaticResource FluentTextTertiary}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
