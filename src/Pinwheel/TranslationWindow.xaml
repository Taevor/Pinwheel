<Window x:Class="Pinwheel.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinwheel 划词翻译"
        Width="480" Height="580" MinWidth="380" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource FluentWindowBackground}"
            BorderBrush="{StaticResource FluentWindowBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="18" ShadowDepth="4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- 标题栏与工具条 -->
                <RowDefinition Height="Auto" /> <!-- 可折叠配置抽屉 -->
                <RowDefinition Height="*" /> <!-- 翻译卡片流 -->
                <RowDefinition Height="Auto" /> <!-- 底部快速输入栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题栏（可拖拽） -->
            <Border Grid.Row="0" Background="{StaticResource FluentCardBackground}" 
                    CornerRadius="11,11,0,0" BorderBrush="{StaticResource FluentCardBorderSubtle}" 
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Pinwheel 翻译" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource FluentTextPrimary}" VerticalAlignment="Center" />
                        <Border x:Name="StatusBadge" Background="#107C41" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="StatusBadgeText" Text="已配置" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧工具按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 置顶图钉按钮 -->
                        <Button x:Name="PinButton" Click="PinButton_Click" ToolTip="置顶显示" 
                                Width="30" Height="30" Margin="0,0,4,0" Style="{StaticResource FluentGhostButton}">
                            <TextBlock x:Name="PinIcon" Text="📌" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- API 配置按钮 -->
                        <Button x:Name="ConfigButton" Click="ConfigButton_Click" ToolTip="翻译 API 设置" 
                                Width="30" Height="30" Margin="0,0,4,0" Style="{StaticResource FluentGhostButton}">
                            <TextBlock Text="⚙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- 清空记录按钮 -->
                        <Button x:Name="ClearButton" Click="ClearButton_Click" ToolTip="清空所有记录" 
                                Width="30" Height="30" Margin="0,0,6,0" Style="{StaticResource FluentGhostButton}">
                            <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- 关闭按钮（用户手动关闭） -->
                        <Button Click="CloseButton_Click" ToolTip="关闭窗口" 
                                Width="30" Height="30" Style="{StaticResource FluentGhostButton}">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Foreground="{StaticResource FluentTextSecondary}" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 可折叠 API 配置抽屉（首次使用自动展开） -->
            <Border x:Name="ConfigDrawer" Grid.Row="1" Background="{StaticResource FluentCardBackgroundSecondary}" 
                    BorderBrush="{StaticResource FluentCardBorder}" BorderThickness="0,0,0,1" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="🛠 翻译服务配置" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource FluentTextPrimary}" />
                        <TextBlock x:Name="ConfigHintText" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource FluentAccent}" />
                    </Grid>

                    <!-- 服务提供商预设 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="服务平台" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" />
                        <ComboBox x:Name="ProviderComboBox" Grid.Column="1" Height="28" SelectionChanged="ProviderComboBox_SelectionChanged">
                            <ComboBoxItem Content="DeepSeek (官方推荐，优质地道)" Tag="DeepSeek" IsSelected="True" />
                            <ComboBoxItem Content="硅基流动 (SiliconFlow DeepSeek-V3)" Tag="SiliconFlow" />
                            <ComboBoxItem Content="OpenAI (GPT-4o / GPT-4o-mini)" Tag="OpenAI" />
                            <ComboBoxItem Content="自定义 OpenAI 兼容接口" Tag="Custom" />
                            <ComboBoxItem Content="内置免密轻量通道 (免 Key 快速试用)" Tag="Free" />
                        </ComboBox>
                    </Grid>

                    <!-- API Key -->
                    <Grid x:Name="ApiKeyRow" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="API Key" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" />
                        <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Height="28" Margin="0,0,6,0" />
                        <TextBox x:Name="ApiKeyTextBox" Grid.Column="1" Height="28" Margin="0,0,6,0" Visibility="Collapsed" />
                        <Button x:Name="ToggleKeyVisibilityButton" Grid.Column="2" Click="ToggleKeyVisibility_Click" 
                                Width="28" Height="28" ToolTip="显示/隐藏 Key" Style="{StaticResource FluentGhostButton}">
                            <TextBlock x:Name="KeyEyeIcon" Text="👁" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- BaseUrl 与 Model -->
                    <Grid x:Name="AdvancedRow" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="接口地址" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" />
                        <TextBox x:Name="BaseUrlBox" Grid.Column="1" Height="28" Margin="0,0,8,0" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="模型" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" />
                        <TextBox x:Name="ModelBox" Grid.Column="3" Height="28" FontSize="11" />
                    </Grid>

                    <!-- 保存与测试按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="TestConnection_Click" Content="测试连接" Height="28" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource FluentSecondaryButton}" />
                        <Button Click="SaveConfig_Click" Content="保存配置" Height="28" Padding="16,0" Style="{StaticResource FluentAccentButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 历史翻译卡片流 -->
            <Grid Grid.Row="2">
                <!-- 空白提示 -->
                <StackPanel x:Name="EmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="📖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5" />
                    <TextBlock Text="暂无翻译记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" 
                               Foreground="{StaticResource FluentTextSecondary}" Margin="0,0,0,4" />
                    <TextBlock Text="在任意软件中选中文本，触发「划词翻译」指令&#x0a;即可在此查看翻译结果并自动保留记录。" 
                               FontSize="12" TextAlignment="Center" Foreground="{StaticResource FluentTextTertiary}" LineHeight="18" />
                </StackPanel>

                <!-- 卡片列表 -->
                <ScrollViewer x:Name="CardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                    <StackPanel x:Name="CardsContainer" />
                </ScrollViewer>
            </Grid>

            <!-- 4. 底部快速输入栏 -->
            <Border Grid.Row="3" Background="{StaticResource FluentCardBackground}" 
                    CornerRadius="0,0,11,11" BorderBrush="{StaticResource FluentCardBorderSubtle}" 
                    BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ManualInputBox" Height="32" Padding="10,6" 
                             BorderThickness="1" BorderBrush="{StaticResource FluentCardBorder}" 
                             KeyDown="ManualInputBox_KeyDown"
                             FontSize="12" />
                    <TextBlock IsHitTestVisible="False" Text="输入文字按 Enter 立即翻译…" 
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" 
                               Foreground="{StaticResource FluentTextTertiary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ManualInputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Click="ManualTranslate_Click" Content="翻译" 
                            Height="32" Padding="16,0" Margin="8,0,0,0" 
                            Style="{StaticResource FluentAccentButton}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

