<Window x:Class="Pinwheel.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinwheel 通知"
        Width="350" Height="78"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <!-- 现代 Win11 Fluent 卡片底座（带柔和投影、微边框） -->
        <Border x:Name="CardBorder"
                Background="#FAFBFD"
                BorderBrush="#D8DFE8"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.14" Color="#000000" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- 底部 3 秒微进度条 -->
                <ProgressBar x:Name="TimeoutProgress"
                             VerticalAlignment="Bottom"
                             Height="2.5"
                             Minimum="0" Maximum="3000" Value="3000"
                             Foreground="{StaticResource FluentAccent}"
                             Background="Transparent"
                             BorderThickness="0"
                             Opacity="0.85" />

                <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：状态图标基底（Success/Error/Info 或指令 Emoji） -->
                    <Border x:Name="IconBadge" Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="6"
                            Background="#EBFAF0"
                            BorderBrush="#BDEAC8"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 矢量状态勾/叉/感叹号 -->
                            <Path x:Name="StatusPath"
                                  Data="M 9 16.2 L 4.8 12 L 3.4 13.4 L 9 19 L 21 7 L 19.6 5.6 L 9 16.2 Z"
                                  Fill="#107C41"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <!-- 指令自带 Emoji（可选覆盖） -->
                            <TextBlock x:Name="EmojiIcon"
                                       FontSize="15"
                                       FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- 中间：标题与内容文字 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="指令执行完成"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource FluentTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MessageText"
                                   Text="已成功处理完毕"
                                   FontSize="11.5"
                                   Foreground="{StaticResource FluentTextSecondary}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 右侧：轻量关闭按钮 -->
                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Style="{StaticResource FluentSubtleButton}"
                            Width="24" Height="24"
                            Padding="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip="关闭通知">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource FluentTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

